// Schema-qualified composite refs, many-to-many, qualified enums and groups.
Enum sales.region {
  emea
  apac
}
Table sales.accounts {
  tenant_id int
  account_no int
  region sales.region [not null]
  indexes {
    (tenant_id, account_no) [pk]
  }
}
Table sales.invoices {
  id int [pk]
  tenant_id int [not null]
  account_no int [not null]
}
Table sales.tags {
  id int [pk]
}
Ref: sales.invoices.(tenant_id, account_no) > sales.accounts.(tenant_id, account_no)
Ref: sales.invoices.id <> sales.tags.id
TableGroup billing {
  sales.accounts
  sales.invoices
}
