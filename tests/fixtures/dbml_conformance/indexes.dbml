// Index blocks: composite pk and unique, plain indexes, expressions.
Table memberships {
  user_id int [not null]
  team_id int [not null]
  role varchar
  joined_at timestamp
  indexes {
    (user_id, team_id) [pk]
    (team_id, role) [unique, name: 'uq_team_role']
    joined_at
    (`lower(role)`)
    role [unique]
  }
}
Table two_pk_columns {
  a int [pk]
  b int [pk]
}
